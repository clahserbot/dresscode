"use client";

import { motion } from 'framer-motion';
import Link from 'next/link';

interface ProductCardProps {
  id: string;
  title: string;
  price: number;
  imageUrl: string;
  category: string;
}

export default function ProductCard({ id, title, price, imageUrl, category }: ProductCardProps) {
  return (
    <Link href={`/product/${id}`} className="group block w-full outline-none">
      <motion.div 
        className="w-full aspect-[3/4] overflow-hidden bg-gray-100 rounded-2xl mb-4 relative"
        whileHover="hover"
        whileFocus="hover"
        initial="initial"
        variants={{
          initial: { y: 0, boxShadow: "0px 0px 0px rgba(0,0,0,0)" },
          hover: { y: -4, boxShadow: "0px 12px 24px -10px rgba(0,0,0,0.1)" }
        }}
        transition={{ duration: 0.3, ease: "easeOut" }}
      >
        <img 
          src={imageUrl} 
          alt={title} 
          className="w-full h-full object-cover"
        />
        <div 
          className="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        />
      </motion.div>
      <div className="space-y-1 flex flex-col items-start px-2">
        <h3 className="font-bold text-lg text-[#3E2B1E] group-hover:text-[#5D4432] transition-colors duration-300">
          {title}
        </h3>
        <div className="flex justify-between w-full items-center pt-1">
          <p className="text-xs text-gray-500 font-medium capitalize">{category}</p>
          <p className="font-semibold text-sm text-[#3E2B1E]">${price.toFixed(2)}</p>
        </div>
      </div>
    </Link>
  );
}
