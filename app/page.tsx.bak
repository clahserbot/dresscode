import { getDb } from '@/db/db';
import { products } from '@/db/schema';
import { desc, eq } from 'drizzle-orm';
import ProductGrid from '@/components/ProductGrid';

export const runtime = 'edge';

export default async function Storefront(props: { searchParams: Promise<{ category?: string }> }) {
  const searchParams = await props.searchParams;
  const db = getDb();
  
  let results;
  if (searchParams.category) {
    results = await db.select().from(products).where(eq(products.category, searchParams.category)).orderBy(desc(products.createdAt));
  } else {
    results = await db.select().from(products).orderBy(desc(products.createdAt));
  }

  return (
    <div className="pt-8">
      {/* Friendly Hero */}
      <section className="mb-24 relative overflow-hidden rounded-[2rem] bg-[#E9E3DD] px-8 py-16 md:py-32 flex flex-col items-center text-center">
        <div className="max-w-3xl space-y-6 relative z-10">
          <span className="inline-block px-4 py-1.5 rounded-full bg-white/50 text-[#5D4432] text-sm font-semibold tracking-wide backdrop-blur-sm mb-4">
            New Arrival
          </span>
          <h1 className="font-bold text-5xl md:text-7xl tracking-tight text-[#3E2B1E]">
            Comfort meets <br />
            <span className="text-[#5D4432]">daily style.</span>
          </h1>
          <p className="text-lg text-[#3E2B1E]/70 font-medium max-w-xl mx-auto">
            Discover our latest collection of warm, premium clothing designed for your everyday cozy moments.
          </p>
        </div>
        {/* Soft background shape/gradient */}
        <div className="absolute top-0 right-0 -mr-32 -mt-32 w-[600px] h-[600px] bg-white/20 blur-3xl rounded-full pointer-events-none" />
      </section>

      <div className="flex flex-col md:flex-row justify-between items-baseline mb-12 border-b border-gray-200 pb-6">
        <h2 className="text-2xl font-bold text-[#3E2B1E]">
          {searchParams.category ? <span className="capitalize">{searchParams.category}</span> : 'The Collection'}
        </h2>
        <p className="text-sm text-gray-500 font-medium mt-4 md:mt-0">{results.length} items</p>
      </div>

      {results.length === 0 ? (
        <div className="py-24 text-center text-gray-500">
          <p className="text-lg font-medium">No items found in this category.</p>
        </div>
      ) : (
        <ProductGrid products={results} />
      )}
    </div>
  );
}
